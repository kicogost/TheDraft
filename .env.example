# Copy to .env.local for local development, and set the same keys in the
# Vercel project settings. Never commit real values.

# The Draft's beehiiv publication, in the form pub_xxxxxxxx
BEEHIIV_PUBLICATION_ID=

# Server only. Scope the key to The Draft's publication.
BEEHIIV_API_KEY=

# Set false to run the forms without calling beehiiv at all.
BEEHIIV_ENABLED=false

# Any long random string. Signs the gated download links.
RESOURCE_SIGNING_SECRET=
